# QuranDesk environment configuration.
# Copy this file to `.env` and fill in your R2 details.
# electron-vite injects MAIN_VITE_* into the main process, VITE_* into the renderer.

# Full URL to the catalog manifest on R2 (main process fetches this).
MAIN_VITE_MANIFEST_URL=https://your-bucket.r2.dev/quran/reciters.json

# R2 host — used by the renderer's CSP to allow reciter photo loads.
VITE_R2_HOST=your-bucket.r2.dev
